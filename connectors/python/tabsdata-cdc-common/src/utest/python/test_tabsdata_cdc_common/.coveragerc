[run]
source = tabsdata.connector.cdc.common
omit =
    test*
    test*/**
    */td-temp/*
    uitest
    uitest*
    uitest/**
    uitest*/**
branch = True
parallel = True
disable_warnings = no-data-collected, couldnt-parse
relative_files = True

[report]
skip_empty = True
show_missing = True

[run]
source = tabsdatak.conn.gcs
omit =
    test*
    test*/**
    */td-temp/*
    utest
    utest*
    utest/**
    utest*/**
    itest
    itest*
    itest/**
    itest*/**
branch = True
parallel = True
disable_warnings = no-data-collected, couldnt-parse
relative_files = True

[report]
skip_empty = True
show_missing = True

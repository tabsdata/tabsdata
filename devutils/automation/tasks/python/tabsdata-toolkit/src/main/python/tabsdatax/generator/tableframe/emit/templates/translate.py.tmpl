"""Boundary translation between wrapper objects and polars objects.

``wrap`` turns a polars object into its wrapper (resolved at runtime via a
registry, so no wrapper module needs to import another); ``unwrap`` returns the
underlying polars object. Both recurse through lists, tuples, and dicts. Because
resolution is by ``type(obj)`` at call time, there are no import cycles.
"""

from __future__ import annotations

from typing import Callable

from .base import BaseFrame, BaseWrapper

# polars type -> factory(polars_obj) -> wrapper. Value wrappers use ``cls._wrap``;
# TableFrame registers ``tableframe_of`` (it wraps a LazyFrame with empty state).
_REGISTRY: dict[type, Callable] = {}

# polars leaf types we deliberately expose as-is (aliased, not wrapped) — e.g.
# datatypes. ``wrap`` returns their instances (and the classes themselves, when
# used as values) unchanged instead of raising as a leak. Populated by the modules
# that alias them (see datatypes.py -> register_passthrough(pl.DataType)).
_PASSTHROUGH: tuple[type, ...] = ()

# optional validator asserting a datatype is allowed (raises if not). Applied to
# datatype args flowing into polars (unwrap) and to incoming LazyFrame schemas
# (validate_schema). Registered by datatypes.py; None => no enforcement.
_TYPE_VALIDATOR: "Callable | None" = None

# Lazy registry population. Importing the package must not drag in polars; the
# root package registers a loader that imports every wrapper submodule (for their
# @register side-effects, the passthrough set, and the type validator). It runs
# once, on first actual use — see _ensure_loaded.
_loader: "Callable | None" = None
_loaded = False


def register(pl_type: type):
    """Class decorator: map a polars type to its wrapper class."""

    def decorator(cls: type) -> type:
        register_factory(pl_type, cls._wrap)
        cls._pl_type = pl_type
        return cls

    return decorator


def register_factory(pl_type: type, factory: Callable) -> None:
    _REGISTRY[pl_type] = factory


def register_passthrough(*types: type) -> None:
    """Mark polars types whose instances (and subclasses used as values) pass
    through ``wrap`` unchanged — aliased leaf types, not a leak."""
    global _PASSTHROUGH
    _PASSTHROUGH = _PASSTHROUGH + tuple(types)


def register_type_validator(fn: Callable) -> None:
    """Register a callable that asserts a datatype is allowed (raises otherwise).
    Applied to datatype arguments in ``unwrap`` and to incoming schemas."""
    global _TYPE_VALIDATOR
    _TYPE_VALIDATOR = fn


def register_loader(fn: Callable) -> None:
    """Register the callback that imports every wrapper submodule (filling the
    registry / passthrough set / type validator). Deferred so ``import <pkg>``
    stays free of the heavy polars import until an op actually runs."""
    global _loader
    _loader = fn


def _ensure_loaded() -> None:
    """Run the loader once (idempotent). No-op if nothing registered a loader."""
    global _loaded
    if _loaded:
        return
    _loaded = True  # set first so any re-entrant wrap()/validate_schema() no-ops
    if _loader is not None:
        _loader()


def _is_passthrough(obj) -> bool:
    """True if obj is an aliased leaf type — a datatype instance, or a class that
    subclasses one (used as a value)."""
    return bool(_PASSTHROUGH) and (
        isinstance(obj, _PASSTHROUGH)
        or (isinstance(obj, type) and issubclass(obj, _PASSTHROUGH))
    )


def validate_schema(lf) -> None:
    """Assert every datatype in a LazyFrame's schema is allowed (no-op if no
    validator is registered). Called at TableFrame construction boundaries — also
    the trigger that activates the (lazily-loaded) datatype validator."""
    _ensure_loaded()
    if _TYPE_VALIDATOR is None:
        return
    for dtype in lf.collect_schema().values():
        _TYPE_VALIDATOR(dtype)


def wrap(obj):
    factory = _REGISTRY.get(type(obj))
    if factory is not None:
        return factory(obj)
    if type(obj) is list:
        return [wrap(x) for x in obj]
    if type(obj) is tuple:
        return tuple(wrap(x) for x in obj)
    if type(obj) is dict:
        return {k: wrap(v) for k, v in obj.items()}
    # Aliased leaf types (e.g. datatypes) are part of our surface as-is.
    if _is_passthrough(obj):
        return obj
    if type(obj).__module__.split(".", 1)[0] == "polars":
        # The wrapper/passthrough for this type may simply not be imported yet —
        # load the registry once and retry before declaring a leak.
        if not _loaded:
            _ensure_loaded()
            return wrap(obj)
        # Nothing should leak a raw polars object out of the delegation API.
        raise TypeError(
            f"tableframe: no wrapper for polars type "
            f"{type(obj).__module__}.{type(obj).__qualname__} — "
            f"it would leak the impl. "
            f"Wrap this type or remove the operation from the whitelist."
        )
    return obj


def unwrap(obj):
    if isinstance(obj, BaseWrapper):
        return obj._inner
    if isinstance(obj, BaseFrame):
        return obj._lf
    if type(obj) is list:
        return [unwrap(x) for x in obj]
    if type(obj) is tuple:
        return tuple(unwrap(x) for x in obj)
    if type(obj) is dict:
        return {k: unwrap(v) for k, v in obj.items()}
    # A datatype passed INTO polars (e.g. cast(Int64)) must be allowed.
    if _TYPE_VALIDATOR is not None and _is_passthrough(obj):
        _TYPE_VALIDATOR(obj)
    return obj
